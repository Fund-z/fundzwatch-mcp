{
  "name": "@fundzwatch/mcp-server",
  "version": "1.2.3",
  "mcpName": "io.github.Fund-z/fundzwatch",
  "description": "MCP server for FundzWatch.ai — real-time business-event intelligence for AI agents: 14 tools, 7 needing no key and no signup, covering funding & exec moves, funded-and-hiring cohorts, UCC refinancing windows, and Form 5500 benefit-plan signals",
  "main": "dist/index.js",
  "bin": {
    "fundzwatch-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "manifest.json",
    "server.json",
    "smithery.yaml",
    "glama.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const f='dist/index.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!')){fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c);}\" && chmod +x dist/index.js",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fundzwatch",
    "business-events",
    "ai-agents",
    "lead-generation",
    "funding-events",
    "sales-intelligence",
    "crunchbase",
    "crunchbase-alternative",
    "funding-data",
    "venture-capital",
    "startup-data",
    "investors",
    "funding-rounds",
    "mergers-acquisitions",
    "sec-edgar",
    "form-d",
    "deal-sourcing",
    "private-markets"
  ],
  "author": "Fundz Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fund-z/fundzwatch-mcp"
  },
  "homepage": "https://fundzwatch.ai",
  "bugs": {
    "url": "https://github.com/Fund-z/fundzwatch-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
